        38.0,
        145.26803705781242,
        156.21752175000003,
        155.87955683514622
      ],
      "text": "1. Mục đích / Purpose",
      "parent_ref": "#/body",
      "child_refs": []
    },
    {
      "id": "#/texts/6",
      "type": "text",
      "label": "text",
      "bbox": [
        38.0,
        171.83688450781244,
        546.4911820000004,
        194.87058752757434
      ],
      "text": "Bảo đảm thiết bị được kiểm tra, hiệu chuẩn và ghi nhận trước khi sử dụng. Áp dụng cho bộ phận Sản xuất và Đảm bảo chất lượng (QA).",
      "parent_ref": "#/body",
      "child_refs": []
    },
    {
      "id": "#/texts/7",
      "type": "heading",
      "label": "section_header",
      "bbox": [
        38.0,
        228.26803705781242,
        119.1625932,
        238.87955683514622
      ],
      "text": "2. Trách nhiệm",
      "parent_ref": "#/body",
      "child_refs": []
    },
    {
      "id": "#/texts/8",
      "type": "text",
      "label": "list_item",
      "bbox": [
        48.0,
        256.78014622781257,
        355.2261535,
        265.8291751871791
      ],
      "text": "Nhân viên kiểm tra mã thiết bị QC-017 và tình trạng tem hiệu chuẩn.",
      "parent_ref": "#/groups/1",
      "child_refs": []
    },
    {
      "id": "#/texts/9",
      "type": "text",
      "label": "list_item",
      "bbox": [
        48.0,
        286.78014622781257,
        335.01365251999994,
        295.8291751871791
      ],
      "text": "Trưởng bộ phận xác nhận kết quả theo biểu mẫu QP-74-02-F6.",
      "parent_ref": "#/groups/1",
      "child_refs": []
    },
    {
      "id": "#/texts/10",
      "type": "text",
      "label": "list_item",
      "bbox": [
        48.0,
        316.78014622781257,
        307.7621908000001,
        325.8291751871791
      ],
      "text": "QA lưu hồ sơ; phân biệt mã 0/O, 1/I và số lô A-001-2026.",
      "parent_ref": "#/groups/1",
      "child_refs": []
    },
    {
      "id": "#/texts/11",
      "type": "heading",
      "label": "section_header",
      "bbox": [
        38.0,
        369.26803705781253,
        156.89696590000003,
        379.87955683514633
      ],
      "text": "3. Acceptance criteria",
      "parent_ref": "#/body",
      "child_refs": []
    },
    {
      "id": "#/texts/12",
      "type": "text",
      "label": "text",
      "bbox": [
        38.0,
        395.8368845078125,
        552.2773160000004,
        418.87058752757423
      ],
      "text": "Temperature: 20-25 °C. Relative humidity: 40-70%. Record every deviation and obtain QA approval before releasing the equipment.",
