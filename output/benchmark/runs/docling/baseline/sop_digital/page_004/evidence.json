    {
      "id": "#/texts/21",
      "type": "text",
      "label": "text",
      "bbox": [
        49.0,
        580.8368845078124,
        519.1513390000006,
        603.8705875275742
      ],
      "text": "Ngắt nguồn trước khi vệ sinh. Không sử dụng khi dây dẫn bị hở hoặc vỏ máy nứt. Thông báo ngay cho bộ phận Kỹ thuật nếu phát hiện bất thường.",
      "parent_ref": "#/body",
      "child_refs": []
    },
    {
      "id": "#/texts/22",
      "type": "text",
      "label": "text",
      "bbox": [
        49.0,
        641.8368845078124,
        529.2587640000004,
        664.8705875275742
      ],
      "text": "Disconnect power before cleaning. Record the issue in QP-74-02-F6. Do not release equipment until QA has approved the corrective action.",
      "parent_ref": "#/body",
      "child_refs": []
    },
