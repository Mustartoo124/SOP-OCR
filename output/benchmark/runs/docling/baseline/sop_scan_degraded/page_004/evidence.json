      "label": "text",
      "bbox": [
        47.666666666666664,
        638.6666371744791,
        531.6666666666667,
        667.3333038411458
      ],
      "text": "Disconnect power before cleaning. Record the issue in QP-74-02-F6. Do not release equipment until QA has approved the corrective action.",
